# 展示端自动更新(oneshot,由 stock-autoupdate.timer 周期触发)
# 安装:占位符替换后拷到 /etc/systemd/system/,再 systemctl daemon-reload
[Unit]
Description=Stock Analysis remote auto-update (pull + restart + self-heal)
After=network.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/stock_analysis
# 环境检查用到的必需变量从受限文件注入(同 ingest 的 sync.env)
EnvironmentFile=/etc/stock-analysis/sync.env
Environment=STORE_BACKEND=db
Environment=REMOTE_REPO_DIR=/srv/stock_analysis
Environment=REMOTE_BRANCH=main
# 要重启+健康检查的服务(name:port,逗号分隔)。只跑展示端就设 stock-web:8801;
# 部署了 ingest 再加 ,stock-ingest:8802
Environment=REMOTE_SERVICES=stock-web:8801
# 必需环境变量名。未部署 ingest 的机器只需 STORE_BACKEND;
# 部署了 ingest 再加 ,SYNC_INGEST_TOKEN,SYNC_SIGNING_KEY
Environment=REMOTE_REQUIRED_ENV=STORE_BACKEND
# 码仓有变更才装依赖+重启(失败回滚上一个 commit);没变更直接跳过
ExecStart=/srv/stock_analysis/.venv/bin/python -m ops.remote_update
