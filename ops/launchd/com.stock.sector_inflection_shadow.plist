<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stock.sector_inflection_shadow</string>
  <!-- ④ 消息驱动板块拐点 forward-shadow(纯记录·non-gating);工作日 20:30(情绪 shadow 20:00 之后)。
       不走 LLM(只读情绪 shadow + 全A K线)。装载由用户本人 launchctl load。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/yqg/Documents/projects/stock_analysis/ops/launchd/sector_inflection_shadow.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/yqg/Documents/projects/stock_analysis</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/yqg/.local/state/stock/sector_inflection_shadow.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yqg/.local/state/stock/sector_inflection_shadow.err.log</string>
</dict>
</plist>
