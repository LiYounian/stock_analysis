<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  S1 板块 universe 周度维护(草案 · 不自动 load;由用户本人 launchctl load,约法)。
  定位:程序化流水线 S1(纯量价、无 LLM)。周维护全申万一级板块清单 + 热门标记 + 与上周 diff。
  时点:每周六 18:00(2026-09 调整为周六;以 LIVE 为准)—— 周末盘后离线维护,master kline 已就绪;跑 ~70s。
        出本周板块 universe,供 S2(周六 18:30)读用。非交易日由 runner 回退最近交易日。
  前置:S1 代码已在主仓 main(f8d2a9e/合入 e199ebf)。
  装载:launchctl load ~/Library/LaunchAgents/com.stock.sector_universe.plist(先把本文件与 sector_universe.sh 就位)。
  cron 等价:tasks.yaml sector_universe = "0 18 * * sat"(test_scheduler_launchd_equivalence 锁)。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stock.sector_universe</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/yqg/Documents/projects/stock_analysis/ops/launchd/sector_universe.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/yqg/Documents/projects/stock_analysis</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/yqg/.local/state/stock/sector_universe.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yqg/.local/state/stock/sector_universe.err.log</string>
</dict>
</plist>
