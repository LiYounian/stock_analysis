<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 午盘选股复盘(下午 α · D-0 当日闭环)。工作日 15:12 触发(breadth 15:05 之后)。
     ⚠️ 草案:由统筹/用户 launchctl load 安装,实现窗不安装、不 load。
     安装前请确认 ProgramArguments 里的 .sh 路径与本机 dailyjob worktree 一致(下方给的是
     与 com.stock.intraday_screen.plist 同款的双路径兜底,按本机实际改)。 -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.stock.intraday_review</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/yqg/Documents/projects/worktrees/stock_analysis/dailyjob/ops/launchd/intraday_review.sh</string>
		<string>/Users/yqg/Documents/projects/stock_analysis/ops/launchd/intraday_review.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/yqg/.local/state/stock/intraday_review.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/yqg/.local/state/stock/intraday_review.out.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>12</integer><key>Weekday</key><integer>1</integer></dict>
		<dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>12</integer><key>Weekday</key><integer>2</integer></dict>
		<dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>12</integer><key>Weekday</key><integer>3</integer></dict>
		<dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>12</integer><key>Weekday</key><integer>4</integer></dict>
		<dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>12</integer><key>Weekday</key><integer>5</integer></dict>
	</array>
</dict>
</plist>
